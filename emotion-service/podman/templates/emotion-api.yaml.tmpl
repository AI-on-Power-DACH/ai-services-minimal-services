apiVersion: v1
kind: Pod
metadata:
  name: "emotion-api-{{ .InstanceSlug }}"
  labels:
    ai-services.io/template: "{{ .TemplateID }}"
  annotations:
    ai-services.io/routes: "9500:emotion-api-{{ .InstanceSlug }}:api"
    # ai-services.io/ports: "{{ or .Values.emotion.port }}:9500"  # Uncomment to expose ports directly (bypasses Caddy)
spec:
  restartPolicy: always
  volumes:
    {{- if .Values.llm.apiKey }}
    - name: vllm-secret
      secret:
        secretName: "vllm-secret-{{ .Values.llm.instanceSlug }}"
    {{- end }}
  containers:
    - name: emotion-api
      image: "{{ .Values.emotion.image }}"
      command:
        - "/bin/sh"
        - "-c"
      args:
      # NOTE: to use the llm apiKey as a secret in this way a
      #       secrets volume (see above) must be created  and mounted (see below).
        - |
          {{- if .Values.llm.apiKey }}
          export LLM_API_KEY=$(cat /etc/secret/vllm-secret/apiKey)
          {{- end }}
          exec python3 -m uvicorn app:app \
            --host 0.0.0.0 \
            --port 9500 \
            --loop uvloop \
            --http httptools
      env:
        - name: PORT
          value: "9500"
        - name: LOG_LEVEL
          value: "{{ .Values.emotion.log_level }}"
        # here the injected values from the llm service (dependency)
        # are rewired into env variables to be used by the settings.py file:
        - name: LLM_ENDPOINT
          value: "http://{{ .Values.llm.host }}:{{ .Values.llm.port }}"
        - name: LLM_MODEL
          value: "{{ .Values.llm.model }}"
        - name: LLM_MAX_MODEL_LEN
          value: "{{ .Values.llm.maxModelLen }}"
        - name: LLM_MAX_BATCH_SIZE
          value: "{{ .Values.llm.maxBatchSize }}"
        
      resources:
        requests:
          memory: "512Mi"
        limits:
          memory: "1Gi"
      volumeMounts:
        {{- if .Values.llm.apiKey }}
        - mountPath: /etc/secret/vllm-secret
          name: vllm-secret
          readOnly: true
        {{- end }}
      ports:
        - containerPort: 9500
          protocol: TCP
      livenessProbe:
        httpGet:
          path: /health
          port: 9500
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 3
